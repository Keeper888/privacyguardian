MONGODB_URI=mongodb+srv://<user>:<pass>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=guardian_agent
MONGODB_COLLECTION=sensitivity_memory
MONGODB_VECTOR_INDEX=sensitivity_vector_idx

EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_DIM=384

SUGGESTER_MODEL=urchade/gliner_small-v2.1
SUGGESTER_THRESHOLD=0.4

LEARNING_SERVER_PORT=4180
SEMANTIC_THRESHOLD=0.65

# Optional: only used if/when the chat is wired to an LLM for AI replies.
# Never commit a real key. agent/.env is gitignored.
MINIMAX_API_KEY=
